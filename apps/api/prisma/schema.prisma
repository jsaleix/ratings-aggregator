// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id                    String                 @id @default(uuid())
  title                 String
  tmdb_id               Int                    @unique
  tag_line              String
  summary               String
  runtime               Int
  release_date          DateTime
  year                  Int
  budget                Float
  poster_path           String
  created_at            DateTime               @default(now()) @db.Timestamp(6)
  updated_at            DateTime               @updatedAt
  original_title        String
  imdb_id               String
  language              String
  slug                  String                 @unique
  Genre                 Genre[]
  Movie_Rating          Movie_Rating[]
  Movie_Ratings_Summary Movie_Ratings_Summary?
  Movie_Job_Pipeline    Movie_Job_Pipeline?
}

model Movie_Job_Pipeline {
  id      String @id @default(cuid())
  tmdb_id Int    @unique
  movie   Movie  @relation(fields: [tmdb_id], references: [tmdb_id])

  status        MovieStatus  @default(FETCHING)
  failed_step   MovieStatus?
  failed_reason String?
  failed_at     DateTime?

  fetched_at    DateTime?
  rated_at      DateTime?
  summarized_at DateTime?
  completed_at  DateTime?
}

model Genre {
  id      String  @id @default(uuid())
  name    String  @unique
  tmdb_id Int     @unique
  movie   Movie[]
}

model Movie_Ratings_Summary {
  id          String   @id @default(uuid())
  content     String   @default("N/A")
  score_value Int      @default(0)
  movieId     String   @unique @map("movie_id")
  Movie       Movie    @relation(fields: [movieId], references: [id])
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt
}

model Movie_Rating {
  id               String        @id @default(uuid())
  movieId          String        @map("movie_id")
  Movie            Movie         @relation(fields: [movieId], references: [id])
  value            String
  extra            String        @default("")
  source_url       String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  rating_source_id String
  Rating_Source    Rating_Source @relation(fields: [rating_source_id], references: [id])
}

model Rating_Source {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  rating_unit  RatingUnit
  url          String
  country_code String
  Movie_Rating Movie_Rating[]
}

model Movie_Request {
  id         String   @id @default(uuid())
  tmdb_id    Int
  created_at DateTime @default(now())
  processed  Boolean  @default(false)
  userId     String   @map("user_id")
  User       User     @relation(fields: [userId], references: [id])
}

model User {
  id            String          @id @default(uuid())
  username      String          @unique
  email         String          @unique
  password      String
  role          Role            @default(user)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  deleted_at    DateTime?
  Movie_Request Movie_Request[]
  verified      Boolean         @default(false)
}

model App_Config {
  key   String @unique
  value String
}

enum RatingUnit {
  points
  stars
  percentage
}

enum RatingsStatus {
  pending
  completed
  failed
}

enum Role {
  user
  admin
  mod
  premium
}

enum MovieStatus {
  FETCHING
  RATING
  SUMMARIZING
  COMPLETE
  FAILED
}
